# /etc/systemd/system/wa-2525-fw.service  (in CT 116)
# Beschränkt den SMTP-in-Port 2525 auf PMG (.31) — für IPv4 UND IPv6 (nftables
# inet, Regeln in /etc/rosenweg/wa-2525-fw.nft, Repo: wa-2525-fw.nft). Sonst
# könnten LAN-Hosts PMG umgehen und mit gefälschtem MAIL FROM Mail->WhatsApp
# einschleusen (smtp_senders ist envelope-basiert + ohne PMG kein SPF-Reject).
# Früher nur iptables (IPv4) -> über IPv6 war 2525 offen (I-11). IPv6 bleibt an.
[Unit]
Description=Restrict WhatsApp SMTP-in (2525) to PMG only (IPv4+IPv6, nftables)
# nach nftables.service (das macht "flush ruleset"), vor Docker
After=nftables.service
Before=docker.service network-online.target
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/rosenweg/wa-2525-fw.nft
ExecReload=/usr/sbin/nft -f /etc/rosenweg/wa-2525-fw.nft
ExecStop=/usr/sbin/nft delete table inet rw_wa_2525

[Install]
WantedBy=multi-user.target
