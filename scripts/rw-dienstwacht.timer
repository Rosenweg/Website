[Unit]
Description=Dienstwacht: Container regelmässig auf klemmende Dienste ansehen

[Timer]
# Alle 15 Minuten. Es geht nicht um Sekunden — die Ausfälle, die diese
# Wacht finden soll, dauerten vier bis siebzehn Tage. Wichtiger als
# Häufigkeit ist, dass sie überhaupt jemand bemerkt.
OnBootSec=10min
OnUnitActiveSec=15min
RandomizedDelaySec=2min
Persistent=true

[Install]
WantedBy=timers.target
