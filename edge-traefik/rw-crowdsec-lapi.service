[Unit]
Description=nft: CrowdSec-API nur fuer lokale Bouncer und PMG
Before=crowdsec.service
After=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/rosenweg/rw-crowdsec-lapi.nft
ExecStop=/usr/sbin/nft delete table inet rw_crowdsec_lapi

[Install]
WantedBy=multi-user.target
