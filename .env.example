# Database
DB_PASSWORD=changeme

# SMTP2GO (mail-eu.smtp2go.com:2525)
SMTP_USER=
SMTP_PASS=
SMTP2GO_API_KEY=

# Authentik OAuth2
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_SECRET_KEY=
AUTHENTIK_DB_PASSWORD=changeme
AUTHENTIK_API_TOKEN=

# MQTT: nicht-interaktiver Login fuer Clients (statt Browser-Token).
# Opt-in — nur mit TLS-Broker aktivieren (Credential geht im MQTT-CONNECT rueber).
# Authentik kennt kein ROPC mit echtem Login-Passwort: der Client sendet
# username = Authentik-User/E-Mail, password = ein am Konto erzeugtes
# App-Passwort-Token. Der (dedizierte) OAuth2-Provider muss den Grant
# "Password"/"Client credentials" erlauben. Einrichtung: docs/mqtt-authentik-login.md
# Dediziert: MQTT_ROPC_CLIENT_ID setzen, Secret leer (Public Client) oder explizit.
MQTT_PASSWORD_LOGIN=0
MQTT_ROPC_CLIENT_ID=
MQTT_ROPC_CLIENT_SECRET=

# Email Inbound Secret (shared with Cloudflare Worker)
EMAIL_INBOUND_SECRET=changeme
