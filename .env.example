# Database
DB_PASSWORD=changeme

# SMTP2GO (mail-eu.smtp2go.com:2525)
SMTP_USER=
SMTP_PASS=
SMTP2GO_API_KEY=

# Authentik OAuth2
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_SECRET_KEY=
AUTHENTIK_DB_PASSWORD=changeme
AUTHENTIK_API_TOKEN=

# MQTT: nicht-interaktiver Login (Authentik-User/E-Mail + Passwort statt Browser-Token).
# Opt-in — nur mit TLS-Broker aktivieren (Passwort geht im MQTT-CONNECT uebertragen).
# Der genutzte Authentik-OAuth2-Provider muss den Password-Grant (ROPC) erlauben.
# Client-ID/Secret fallen ohne eigene Werte auf AUTHENTIK_CLIENT_ID/SECRET zurueck.
MQTT_PASSWORD_LOGIN=0
MQTT_ROPC_CLIENT_ID=
MQTT_ROPC_CLIENT_SECRET=

# Email Inbound Secret (shared with Cloudflare Worker)
EMAIL_INBOUND_SECRET=changeme
