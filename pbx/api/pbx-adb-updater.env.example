# /etc/default/pbx-adb-updater (optional; Standardwerte stehen in adb_updater.py)
# Nur in diese Netze verbindet sich der Updater (abgemeldete Telefone: RK-Clients).
PBX_ADB_NETZE=100.64.9.0/24
# Rosenweg Geraet (Kiosk/Anmeldung) nur in diesem Zeitfenster aktualisieren (Ortszeit, Stunden)
PBX_ADB_NACHT=01-05
# so lange nach einer Abmeldung warten (Nachlauf/Uploads)
PBX_ADB_RUHE_MIN=10
# Akku mindestens (oder am Strom)
PBX_ADB_AKKU_MIN=30
PBX_ADB_HOME=/var/lib/pbx-adb
