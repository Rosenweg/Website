# Config der PBX-API — nach /etc/default/pbx-api kopieren (chmod 600).
# PBX_SHARED_SECRET wird i.d.R. aus /etc/default/asterisk-env geerbt (gleicher
# Wert wie die AGI-Scripts nutzen); hier nur setzen, wenn separat gewuenscht.

# Reverse-Proxy-Ziel fuer Authentik-Login + Bearer-Validierung (Haupt-API).
MAIN_API_BASE=http://100.64.2.27:3000

# Oeffentlicher Host des Admin-UI (fuer X-Forwarded-Host beim OAuth-Redirect).
PBX_PUBLIC_HOST=pbx.rosenweg4303.ch

# Lokaler Port der API (CF-Tunnel/Traefik-Ingress zeigt hierauf).
PBX_API_PORT=8095

# Pfade
PBX_DB_PATH=/var/lib/pbx-api/pbx.sqlite
ASTERISK_PHONES_CONF=/etc/asterisk/pjsip_phones.conf
PBX_WEB_DIR=/opt/pbx-api/web

# AGI<->API Shared-Secret (sonst aus asterisk-env geerbt):
# PBX_SHARED_SECRET=...

# ─── Voicemail-KI (autark in CT 220) ────────────────────────────────────────
# Transkription: Groq bevorzugt (gratis/schnell, whisper-large-v3), sonst OpenRouter.
GROQ_API_KEY=
OPENROUTER_API_KEY=
VOICEMAIL_MODEL=anthropic/claude-haiku-4.5

# WhatsApp-Zustellung DIREKT ueber das Gateway (kein Umweg ueber Haupt-API).
# Key im Gateway-Web-UI (whatsapp.rosenweg4303.ch) anlegen -> mg_...
GATEWAY_SEND_URL=https://whatsapp.rosenweg4303.ch/gateway/send
GATEWAY_API_KEY=
VOICEMAIL_WA_TARGET=Rosenweg Technik

# Optional: Webhook an die Haupt-API fuer die Rosenweg-Auto-Reklamation.
# Leer = aus (PBX bleibt vollstaendig autark, nur WhatsApp + Speicherung).
FORWARD_VOICEMAIL_URL=
# FORWARD_VOICEMAIL_SECRET=  (default = PBX_SHARED_SECRET)
