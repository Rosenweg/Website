# Multi-STWEG-Frontend (stweg1..8.rosenweg4303.ch). EIN Image, nginx waehlt
# den docroot per Host-Header (nginx.stweg.conf). Pro STWEG laeuft ein eigener
# Swarm-Service (Isolation), alle aus diesem Image. Die Waschkueche-Module
# (stweg3/pages/waschkueche-*.html + stweg3/waschkueche-smart/) wandern damit
# komplett aus der Hauptseite in den stweg3-Container.
FROM nginx:1.27-alpine

# Config als Template — der nginx-Entrypoint substituiert ${WASCHKUECHE}
# per envsubst beim Start (nginx-Runtime-Vars wie $site/$host/$uri bleiben,
# da sie keine Env-Vars sind). Default WASCHKUECHE=0 (Modul aus), pro
# Service per --env-add WASCHKUECHE=1 zuschaltbar.
RUN rm /etc/nginx/conf.d/default.conf
COPY nginx.stweg.conf /etc/nginx/templates/default.conf.template
ENV WASCHKUECHE=0

WORKDIR /usr/share/nginx/html

# STWEG-Inhalte (inkl. Waschkueche unter stweg3/)
COPY stweg1/ stweg1/
COPY stweg2/ stweg2/
COPY stweg3/ stweg3/
COPY stweg4/ stweg4/
COPY stweg5/ stweg5/
COPY stweg6/ stweg6/
COPY stweg7/ stweg7/
COPY meg/ meg/

# Shared Frontend-Module + Config + Logo (host-unabhaengig am Root)
COPY js/ js/
COPY css/ css/
COPY site-config.json .
COPY logo-rosenweg.png .

# Waschkueche-Modul (zuschaltbar via WASCHKUECHE=1). Liegt als
# _waschkueche.html im Image; nginx serviert es nur bei WASCHKUECHE=1
# unter /waschkueche.html. Kontext (welche STWEG) aus dem Hostname.
COPY waschkueche.html _waschkueche.html

# nginx-Default-Index entfernen (wir routen alles per Host -> /stwegN)
RUN rm -f index.html

EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -qO- http://localhost/health || exit 1
