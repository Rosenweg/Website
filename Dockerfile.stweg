# Multi-STWEG-Frontend (stweg1..8.rosenweg4303.ch). EIN Image, nginx waehlt
# den docroot per Host-Header (nginx.stweg.conf). Pro STWEG laeuft ein eigener
# Swarm-Service (Isolation), alle aus diesem Image. Die Waschkueche-Module
# (stweg3/pages/waschkueche-*.html + stweg3/waschkueche-smart/) wandern damit
# komplett aus der Hauptseite in den stweg3-Container.

# Stufe 1: STWEG/MEG-Verzeichnisse per Positivliste (wie assemble_stweg in
# frontends-lxc/deploy.sh). Frueher kamen data/kontakte.json (Namen, Mails,
# Telefon) und README.md mit ins oeffentliche Docroot.
FROM alpine:3.20 AS stwegroot
RUN apk add --no-cache rsync
COPY stweg1/ /src/stweg1/
COPY stweg2/ /src/stweg2/
COPY stweg3/ /src/stweg3/
COPY stweg4/ /src/stweg4/
COPY stweg5/ /src/stweg5/
COPY stweg6/ /src/stweg6/
COPY stweg7/ /src/stweg7/
COPY meg/ /src/meg/
RUN mkdir /out && cd /src && rsync -a --prune-empty-dirs --exclude='data/' --include='*/' \
      --include='*.html' --include='*.pdf' --include='*.png' --include='*.jpg' --include='*.jpeg' \
      --include='*.svg' --include='*.webp' --include='*.ico' --include='*.js' --include='*.css' \
      --exclude='*' \
      stweg1 stweg2 stweg3 stweg4 stweg5 stweg6 stweg7 meg /out/

FROM nginx:1.27-alpine

# Config als Template — der nginx-Entrypoint substituiert ${WASCHKUECHE}
# per envsubst beim Start (nginx-Runtime-Vars wie $site/$host/$uri bleiben,
# da sie keine Env-Vars sind). Default WASCHKUECHE=0 (Modul aus), pro
# Service per --env-add WASCHKUECHE=1 zuschaltbar.
RUN rm /etc/nginx/conf.d/default.conf
COPY nginx.stweg.conf /etc/nginx/templates/default.conf.template
# Gemeinsame Sicherheits-Header (per include in nginx.stweg.conf)
COPY frontends-lxc/nginx/sicherheit-header.conf /etc/nginx/snippets/rosenweg-sicherheit.conf
ENV WASCHKUECHE=0

WORKDIR /usr/share/nginx/html

# STWEG-Inhalte (inkl. Waschkueche unter stweg3/) aus der Positivliste der
# ersten Stufe: nur Web-Dateitypen, kein data/, keine README.md.
COPY --from=stwegroot /out/ ./

# Shared Frontend-Module + Config + Logo (host-unabhaengig am Root)
COPY js/ js/
COPY css/ css/
COPY site-config.json .
COPY logo-rosenweg.png .
# STWEG-spezifische Logos (Frontend faellt per onerror auf logo-rosenweg.png zurueck)
COPY logo-stweg3-rosenweg9.png logo-stweg6-rosenweg1.png ./

# Waschkueche-Modul (zuschaltbar via WASCHKUECHE=1). Liegt als
# _waschkueche.html im Image; nginx serviert es nur bei WASCHKUECHE=1
# unter /waschkueche.html. Kontext (welche STWEG) aus dem Hostname.
COPY waschkueche.html _waschkueche.html

# nginx-Default-Index entfernen (wir routen alles per Host -> /stwegN)
RUN rm -f index.html

EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -qO- http://localhost/health || exit 1
