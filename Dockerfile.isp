# Eigener Container fuer isp.rosenweg4303.ch (Frontend-only, API geteilt).
# Enthaelt nur ISP-relevante Pages + benoetigte JS-Module.
FROM nginx:1.27-alpine

RUN rm /etc/nginx/conf.d/default.conf
COPY nginx.isp.conf /etc/nginx/conf.d/default.conf

# Whitelist: nur ISP-Seiten + Abhaengigkeiten kopieren
WORKDIR /usr/share/nginx/html

# Entry-Page + Subseiten (Bewohner + Admin)
COPY isp.html .
COPY isp-admin.html .
COPY isp-mein-zugang.html .
COPY wlan.html .
COPY tv.html .
COPY netzwerk.html .
COPY verbindungen.html .
COPY dmarc.html .
COPY noc-fullscreen.html .

# Shared JS-Module (Auth, Site-Config, QR, etc.)
COPY js/ js/

# Auf isp.rosenweg4303.ch: ISP-only-Nav statt der grossen Hauptseiten-Nav.
# Wir UEBERLAGERN nav.js mit nav-isp.js, damit die html-Files unveraendert
# bleiben (laden weiterhin /js/nav.js) und nur der Inhalt anders ist.
RUN cp js/nav-isp.js js/nav.js && rm js/nav-isp.js

# Statische Assets — ISP-spezifisches Logo + fallback Rosenweg-Logo
COPY logo-rosenweg.png .
COPY logo-rosenweg-isp.png .
COPY site-config.json .

# Default-Index ersetzen — nginx-image bringt eine eigene mit.
RUN rm -f index.html && ln -s isp.html index.html

EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -qO- http://localhost/health || exit 1
