#!/bin/bash
# ============================================================================
# sysvol-abgleich — Gruppenrichtlinien zwischen dc1 und dc2 abgleichen
# ============================================================================
# Samba gleicht das sysvol zwischen Domaenencontrollern NICHT von selbst ab.
# Das Verzeichnis repliziert ueber DRS, die Dateien darunter nicht. Am
# 12. August 2026 so vorgefunden: dc1 vier Richtlinien, dc2 keine.
#
# Bis zum 17. September 2026 lief hier ein einseitiges rsync von dc1 nach dc2.
# Das war im Normalbetrieb richtig — Windows schreibt Richtlinien immer auf den
# PDC-Emulator, und den haelt dc1 — aber im Ernstfall falsch:
#
#   Faellt dc1 aus und die FSMO-Rollen wandern auf dc2, ist dc2 die neue
#   Quelle. Das Skript lag aber auf dc1 und schob hartkodiert in die andere
#   Richtung. Kam dc1 zurueck, ueberschrieb sein VERALTETER Stand per
#   --delete den aktuellen von dc2. Genau im Notfall, fuer den die Redundanz
#   da ist, arbeitete die Einrichtung gegen uns.
#
# Darum jetzt zweiwegig mit unison: es entscheidet pro Datei, welche Seite die
# juengere ist, und braucht keine fest verdrahtete Richtung. Der Lauf startet
# von beiden Controllern aus — auch das ist Absicht: liegt einer, holt der
# andere nach, sobald er wieder da ist.
#
# unison uebertraegt die Dateien NICHT selbst, sondern laesst rsync -XA das
# tun (siehe sysvol.prf) — sonst gingen die POSIX-ACLs in den erweiterten
# Attributen verloren.
# ============================================================================
set -uo pipefail

PFAD="/var/lib/samba/sysvol"
DOMAENE="ad.rosenweg4303.ch"

# Die Gegenseite ergibt sich aus dem eigenen Namen. Kein zweites Skript, keine
# zwei Varianten, die auseinanderlaufen koennen.
case "$(hostname -s)" in
    dc1) GEGEN="dc2" ;;
    dc2) GEGEN="dc1" ;;
    *)   echo "sysvol-abgleich: laeuft nur auf dc1 oder dc2, nicht auf $(hostname -s)" >&2
         exit 1 ;;
esac

# Nur ein Lauf gleichzeitig. Die Timer der beiden Controller sind um fuenf
# Minuten versetzt, aber ein langsamer Lauf darf sich nicht mit dem naechsten
# ueberholen.
exec 9>/run/sysvol-abgleich.lock
if ! flock -n 9; then
    echo "sysvol-abgleich: laeuft bereits, dieser Lauf entfaellt."
    exit 0
fi

# Erreichbarkeit zuerst pruefen. Ist die Gegenseite weg, ist das kein Fehler,
# sondern der Normalfall waehrend eines Neustarts — unison wuerde sonst mit
# einem unverstaendlichen Fehler abbrechen und den Timer als "failed" markieren.
if ! ssh -o BatchMode=yes -o ConnectTimeout=10 \
         -o StrictHostKeyChecking=accept-new \
         "root@$GEGEN.$DOMAENE" true 2>/dev/null; then
    echo "sysvol-abgleich: $GEGEN nicht erreichbar, uebersprungen."
    exit 0
fi

unison sysvol \
    "$PFAD" "ssh://root@$GEGEN.$DOMAENE/$PFAD" \
    -logfile /var/log/sysvol-abgleich.log
RC=$?

# 0 = nichts zu tun oder alles uebertragen, 1 = uebersprungene Dateien
# (Konflikt, den "prefer = newer" nicht aufloesen konnte). Beides ist kein
# Grund, den Dienst als gescheitert zu melden — aber sichtbar soll es sein.
if [ "$RC" -eq 1 ]; then
    echo "sysvol-abgleich: einzelne Dateien uebersprungen, siehe /var/log/sysvol-abgleich.log" >&2
elif [ "$RC" -gt 1 ]; then
    echo "sysvol-abgleich: unison beendet mit $RC" >&2
    exit "$RC"
fi

# Die Rechte im Verzeichnis nachziehen. unison bringt die Dateien, die
# Zuordnung zu den AD-Gruppen macht Samba selbst.
samba-tool ntacl sysvolreset 2>&1 | tail -2

exit 0
