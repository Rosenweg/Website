#!/bin/bash
# ============================================================================
# sysvol-abgleich — Gruppenrichtlinien zwischen dc1 und dc2 abgleichen
# ============================================================================
# Samba gleicht das sysvol zwischen Domaenencontrollern NICHT von selbst ab.
# Das Verzeichnis repliziert ueber DRS, die Dateien darunter nicht. Am
# 12. August 2026 so vorgefunden: dc1 vier Richtlinien, dc2 keine.
#
# Bis zum 17. September 2026 lief hier ein einseitiges rsync von dc1 nach dc2.
# Das war im Normalbetrieb richtig — Windows schreibt Richtlinien immer auf den
# PDC-Emulator, und den haelt dc1 — aber im Ernstfall falsch:
#
#   Faellt dc1 aus und die FSMO-Rollen wandern auf dc2, ist dc2 die neue
#   Quelle. Das Skript lag aber auf dc1 und schob hartkodiert in die andere
#   Richtung. Kam dc1 zurueck, ueberschrieb sein VERALTETER Stand per
#   --delete den aktuellen von dc2. Genau im Notfall, fuer den die Redundanz
#   da ist, arbeitete die Einrichtung gegen uns.
#
# Darum jetzt zweiwegig mit unison: es entscheidet pro Datei, welche Seite die
# juengere ist, und braucht keine fest verdrahtete Richtung. Der Lauf startet
# von beiden Controllern aus — auch das ist Absicht: liegt einer, holt der
# andere nach, sobald er wieder da ist.
#
# unison uebertraegt die Dateien NICHT selbst, sondern laesst rsync -XA das
# tun (siehe sysvol.prf) — sonst gingen die POSIX-ACLs in den erweiterten
# Attributen verloren.
# ============================================================================
set -uo pipefail

PFAD="/var/lib/samba/sysvol"
DOMAENE="ad.rosenweg4303.ch"

# Die Gegenseite ergibt sich aus dem eigenen Namen. Kein zweites Skript, keine
# zwei Varianten, die auseinanderlaufen koennen.
case "$(hostname -s)" in
    dc1) GEGEN="dc2" ;;
    dc2) GEGEN="dc1" ;;
    *)   echo "sysvol-abgleich: laeuft nur auf dc1 oder dc2, nicht auf $(hostname -s)" >&2
         exit 1 ;;
esac

# ---------------------------------------------------------------------------
# Was ein Fehler ist — und was nicht
# ---------------------------------------------------------------------------
# Ein Controller, der gerade neu startet oder per HA auf einen anderen Knoten
# umzieht, ist fuer ein paar Sekunden weg. Das ist Normalbetrieb. Faellt ein
# Lauf deshalb aus, holt der naechste es zehn Minuten spaeter nach; als Fehler
# zu melden ist das nicht. Am 18.09.2026 zog dc1 achtmal um — jede dieser
# Meldungen waere Laerm gewesen.
#
# Umgekehrt darf ein ANHALTENDES Problem nicht still bleiben. Die erste
# Fassung uebersprang eine unerreichbare Gegenseite kommentarlos — lag dc2
# wieder drei Tage still wie im September, haette der Abgleich das nie
# gemeldet.
#
# Darum zaehlen wir Laeufe ohne Erfolg in Folge. Erst ab dem dritten (also
# nach rund 30 Minuten) endet der Dienst mit Fehler und die Dienstwacht
# meldet ihn. Ein Umzug dauert unter einer Minute und verpasst hoechstens
# einen Lauf.
ZAEHLER_DATEI="/var/lib/sysvol-abgleich/ohne-erfolg"
SCHWELLE=3

erfolg() {
    rm -f "$ZAEHLER_DATEI"
    exit 0
}

ohne_erfolg() {   # $1 = Grund
    local n
    n=$(( $(cat "$ZAEHLER_DATEI" 2>/dev/null || echo 0) + 1 ))
    echo "$n" > "$ZAEHLER_DATEI"
    if [ "$n" -ge "$SCHWELLE" ]; then
        echo "sysvol-abgleich: $1 — seit $n Laeufen kein Abgleich mehr." >&2
        exit 1
    fi
    echo "sysvol-abgleich: $1 — Lauf $n/$SCHWELLE ohne Erfolg, naechster Versuch in 10 Minuten."
    exit 0
}

gegenseite_da() {
    ssh -o BatchMode=yes -o ConnectTimeout=10 \
        -o StrictHostKeyChecking=accept-new \
        "root@$GEGEN.$DOMAENE" true 2>/dev/null
}

# Nur ein Lauf gleichzeitig. Die Timer der beiden Controller sind um fuenf
# Minuten versetzt, aber ein langsamer Lauf darf sich nicht mit dem naechsten
# ueberholen.
exec 9>/run/sysvol-abgleich.lock
if ! flock -n 9; then
    echo "sysvol-abgleich: laeuft bereits, dieser Lauf entfaellt."
    exit 0
fi

# Wird ein Lauf hart abgebrochen — etwa weil der Container mitten im Abgleich
# umzieht —, bleiben unisons Sperrdateien liegen und blockieren jeden
# folgenden Lauf. Wir halten die flock oben, also laeuft hier sicher kein
# anderes unison; eine Sperre aelter als 30 Minuten ist verwaist (ein Lauf
# dauert Sekunden).
find /root/.unison -maxdepth 1 -name 'lk*' -mmin +30 -delete 2>/dev/null

gegenseite_da || ohne_erfolg "$GEGEN nicht erreichbar"

unison sysvol \
    "$PFAD" "ssh://root@$GEGEN.$DOMAENE/$PFAD" \
    -logfile /var/log/sysvol-abgleich.log
RC=$?

# 0 = nichts zu tun oder alles uebertragen, 1 = einzelne Dateien
# uebersprungen (Konflikt, den "prefer = newer" nicht aufloesen konnte).
if [ "$RC" -ge 2 ]; then
    # Ist die Gegenseite waehrend des Laufs verschwunden, war es ein Umzug
    # oder Neustart, kein Defekt.
    if gegenseite_da; then
        ohne_erfolg "unison beendet mit $RC"
    else
        ohne_erfolg "$GEGEN waehrend des Laufs weggefallen (Neustart/Umzug?)"
    fi
fi
if [ "$RC" -eq 1 ]; then
    echo "sysvol-abgleich: einzelne Dateien uebersprungen, siehe /var/log/sysvol-abgleich.log" >&2
fi

# Die Rechte im Verzeichnis nachziehen. unison bringt die Dateien, die
# Zuordnung zu den AD-Gruppen macht Samba selbst.
samba-tool ntacl sysvolreset 2>&1 | tail -2

erfolg
